# ip used by frontend/client-side urls to access the backend
# (used in compose for SUPABASE_PUBLIC_URL)
HOST_IP=localhost
READEST_IMAGE=ghcr.io/readest/readest:latest

# Host ports. Change these when another stack already binds
# 3000 / 8000 / 9000 / 9001. SITE_URL and API_EXTERNAL_URL must match.
CLIENT_HTTP_PORT=3000
KONG_HTTP_PORT=8000
# Optional bind addresses (default 0.0.0.0). Use 127.0.0.1 to keep them local.
# CLIENT_BIND=0.0.0.0
# KONG_BIND=0.0.0.0

# browser-facing urls, derived from HOST_IP unless set here. behind an https
# reverse proxy, point both at the single public origin (see README).
# SUPABASE_PUBLIC_URL=https://your-domain.com
# S3_PUBLIC_ENDPOINT=https://your-domain.com

# db(psql) config
# change to strong password, min 32 chars
POSTGRES_PASSWORD=your-super-secret-postgres-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# jwt config
JWT_EXPIRY=3600
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters
# both ANON_KEY and SERVICE_ROLE_KEY should be generated using the above set secret
# sign this payload -> {"role": "anon"} <- for ANON_KEY with JWT_SECRET
ANON_KEY=your-anon-key-jwt-signed-with-jwt-secret
# sign this payload -> {"role": "service_role"} <- for SERVICE_ROLE_KEY with JWT_SECRET
SERVICE_ROLE_KEY=your-service-role-key-jwt-signed-with-jwt-secret

# auth (gotrue)
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://localhost:3000/**,http://localhost:8000/**

# readest auth stuff
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false

# only needed if ENABLE_EMAIL_AUTOCONFIRM is false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_SENDER_NAME=Readest

# PostgREST shiz
PGRST_DB_SCHEMAS=public,graphql_public

# s3 storage through MinIO
OBJECT_STORAGE_TYPE=s3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-secret-password
S3_BUCKET_NAME=readest-files
S3_REGION=us-east-1
# Bundled MinIO host ports (unused if you point S3_ENDPOINT at an external store).
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Internal SDK endpoint (docker DNS http://minio:9000, or an external URL).
# S3_ENDPOINT=http://minio:9000
# Browser-facing presigned URL host. Defaults to http://${HOST_IP}:${MINIO_API_PORT}.
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# Comma-separated Readest origins allowed to PUT/GET via presigned URLs.
# S3_CORS_ORIGINS=http://localhost:3000
#
# To use an already-running MinIO/S3 instead of the bundled service, set
# S3_ENDPOINT / S3_PUBLIC_ENDPOINT / MINIO_ROOT_* and add a compose override
# that gives the minio service profile "bundled-minio" so it does not start.

# Self-hosted deployments unlock every premium feature, with or without a
# signed-in user. Set to false only if you are running a hosted service that
# sells the plans.
SELF_HOSTED=true

# Exact, comma-separated hostnames/IPs the OPDS proxy may reach on private
# networks. Empty keeps the default block. No schemes, ports or wildcards.
# READEST_TRUSTED_PRIVATE_HOSTS=books.home.arpa,calibre.lan,192.168.1.20
READEST_TRUSTED_PRIVATE_HOSTS=

# 1GB fixed quota for storage and 50k for translations
STORAGE_FIXED_QUOTA=1073741824
TRANSLATION_FIXED_QUOTA=50000

# where the reader loads the self-hosted CJK webfont bundles from.
# leave empty to use Readest's CDN (https://storage.readest.com/public/font/dist),
# which only sends CORS headers for readest.com origins - if you serve the app
# from your own domain and want those fonts, mirror the bundles and point this
# at the directory that holds them, e.g. https://your-domain.com/fonts
FONT_BASE_URL=
